{
  "opencollection": "1.0.0",
  "info": {
    "name": "ProcessOut Balances Cards API",
    "version": "1.0.3"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cards",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Creating a card",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.processout.com/cards",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creating a card"
        },
        {
          "info": {
            "name": "Updating a card",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.processout.com/cards/:card_id",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "card_id",
                "value": "",
                "type": "path",
                "description": "ID of the card tokenized"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updating a card"
        }
      ]
    }
  ],
  "bundled": true
}